# ============================================================
# BKC Sports — Environment Variables Template
# ============================================================
# Copie este arquivo como .env e preencha com os valores reais.
# NUNCA commitar o .env (já está no .gitignore).
# ============================================================


# ----------------------------------------------------------------
# META (Facebook / Instagram) — Pixel + Conversions API
# ----------------------------------------------------------------

# Pixel ID — público, exposto no client (com prefixo VITE_)
# Onde achar: Events Manager > seu Pixel > topo da pagina (numero de 15-16 digitos)
VITE_META_PIXEL_ID=

# Pixel ID — duplicado server-side (sem prefixo VITE_) para a Netlify Function
META_PIXEL_ID=

# Access Token da Conversions API (System User Token)
# CRITICO: server-side apenas, NUNCA expor no client
# Onde gerar: Business Manager > Configuracoes > Usuarios do sistema > Gerar token
META_ACCESS_TOKEN=

# Test Event Code — usar SO em desenvolvimento para validar eventos no Test Events tab
# Deixe vazio em producao
# Onde achar: Events Manager > Test Events > codigo TEST#####
META_TEST_EVENT_CODE=

# App ID e App Secret — para gestao avancada via Marketing API (futuro)
META_APP_ID=
META_APP_SECRET=


# ----------------------------------------------------------------
# GOOGLE — Analytics 4 + Google Ads
# ----------------------------------------------------------------

# GA4 Measurement ID — publico, exposto no client
# Formato: G-XXXXXXXXXX
VITE_GA4_MEASUREMENT_ID=

# Google Ads Conversion ID — publico, exposto no client
# Formato: AW-XXXXXXXXXX
VITE_GOOGLE_ADS_ID=

# Google Ads Conversion Label (Lead Qualificado) — publico
# Formato: ABC-123_xyz (vem com o Conversion ID separado por /)
VITE_GOOGLE_ADS_LEAD_LABEL=
